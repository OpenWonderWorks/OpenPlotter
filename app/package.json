{
  "name": "openplotter-companion",
  "version": "3.0.2",
  "private": true,
  "description": "Open-source cutting plotter companion app — SVG import, G-code generation, and real-time machine control.",
  "main": "electron-main.cjs",
  "type": "module",
  "homepage": "https://github.com/OpenWonderWorks/OpenPlotter",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenWonderWorks/OpenPlotter.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "vite build && set NODE_ENV=development&& electron .",
    "electron:start": "electron .",
    "electron:build": "vite build && electron-builder"
  },
  "devDependencies": {
    "electron": "^30.0.9",
    "electron-builder": "^24.13.3",
    "vite": "^8.0.12"
  },
  "build": {
    "appId": "org.openplotter.app",
    "productName": "OpenPlotter",
    "directories": {
      "output": "dist-desktop"
    },
    "win": {
      "target": "portable",
      "executableName": "OpenPlotter"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "electron-preload.cjs"
    ],
    "extraResources": [
      {
        "from": "../OpenPlotter/src",
        "to": "OpenPlotter/src"
      },
      {
        "from": "../OpenPlotter/openplotter_config.h",
        "to": "OpenPlotter/openplotter_config.h"
      },
      {
        "from": "../OpenPlotter/OpenPlotter.ino",
        "to": "OpenPlotter/OpenPlotter.ino"
      },
      {
        "from": "../OpenPlotter/build",
        "to": "OpenPlotter/build"
      }
    ]
  },
  "dependencies": {
    "serialport": "^13.0.0"
  }
}
