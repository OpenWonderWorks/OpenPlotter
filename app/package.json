{
  "name": "openplotter-companion",
  "version": "3.2.3",
  "private": true,
  "description": "Companion app for OpenPlotter — SVG import, G-code generation, and real-time machine control.",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "electron-main.cjs",
  "type": "module",
  "homepage": "https://github.com/OpenWonderWorks/OpenPlotter",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenWonderWorks/OpenPlotter.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test test/*.test.js",
    "preview": "vite preview",
    "electron:dev": "npm run build && electron .",
    "electron:start": "npm run build && electron .",
    "electron:build": "vite build && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "org.openplotter.app",
    "productName": "OpenPlotter",
    "artifactName": "OpenPlotter-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist-desktop"
    },
    "win": {
      "target": "portable",
      "executableName": "OpenPlotter"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.graphics-design"
    },
    "linux": {
      "target": "AppImage",
      "category": "Graphics"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "electron-preload.cjs",
      "firmware-targets.cjs"
    ],
    "extraResources": [
      {
        "from": "../OpenPlotter/src",
        "to": "OpenPlotter/src"
      },
      {
        "from": "../OpenPlotter/openplotter_config.h",
        "to": "OpenPlotter/openplotter_config.h"
      },
      {
        "from": "../OpenPlotter/OpenPlotter.ino",
        "to": "OpenPlotter/OpenPlotter.ino"
      }
    ]
  },
  "dependencies": {
    "serialport": "^13.0.0"
  },
  "overrides": {
    "minimatch@^9.0.0": "^11.0.8",
    "minimatch@^10.0.0": "^11.0.8"
  }
}
